# Chave secreta para assinar o login (gere com: openssl rand -base64 32)
AUTH_SECRET=troque-por-uma-chave-grande-e-aleatoria

# Usuários permitidos no formato usuario:senha, separados por vírgula
APP_USERS=admin:troque-esta-senha

# IA (opcional) — preencha UMA das duas. Ambas têm plano gratuito.
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
